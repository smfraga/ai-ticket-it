PORT=3000

# Clave para firmar los tokens de sesión. Obligatoria: sin ella el backend no arranca.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración del token (opcional, por defecto 1h)
JWT_EXPIRES_IN=1h

# Orígenes que pueden llamar a la API desde un navegador (opcional), separados por comas.
# La app del celular no lo necesita: CORS solo lo aplican los navegadores. Ejemplo: http://localhost:8081
CORS_ORIGINS=
